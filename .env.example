# Copie para .env e preencha. Nunca faça commit do .env.

# Modelo no formato "provedor:modelo" (LangChain init_chat_model)
RADAR_MODELO=anthropic:claude-opus-5-5
ANTHROPIC_API_KEY=

# E-mail (SMTP com STARTTLS; use senha de app, veja o README)
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
